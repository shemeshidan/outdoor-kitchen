{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev",
      "type": "npm",
      "script": "dev",
      "args": ["--", "--port", "5173", "--strictPort"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activatesOnStart": true,
          "beginsPattern": "^__never_matches__$",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "vite: stop",
      "type": "shell",
      "command": "echo ${input:terminateVite}",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ],
  "inputs": [
    {
      "id": "terminateVite",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "vite: dev"
    }
  ]
}
