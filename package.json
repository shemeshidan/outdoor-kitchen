    "react-router-dom": "^7.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "gh-pages": "^6.3.0",
